# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.pyo
*.pyd

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.binmind_cache/
.coverage
htmlcov/

# 打包产物
build/
dist/
*.egg-info/

# 虚拟环境
venv/
.venv/
env/

# 编辑器与系统文件
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 本地数据与日志
logs/
*.log

# 运行期产物（测试生成，不纳入版本控制）
.cache/
**/firmware_extracted/
**/reports/signature/
**/reports/*/
**/reports/*.json
**/reports/*.md
pocs/
*.sqlite3
*.db-shm
*.db-wal
test_output/
eval_output/
test_scan.json
**/reports/exploit_transpile/
**/modules/*/data/
**/modules/*/hooks/
**/modules/*/reports/
**/modules/*/pocs/
**/modules/*/.cache/

# 测试编译产物
**/*.o
**/*.obj
# cve_binaries 测试固件为 PE 样本，需纳入版本控制
!deemo/tests/cve_binaries/*.exe


**/test.exe

deemo/_trash/
